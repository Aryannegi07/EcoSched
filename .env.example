# Copy this file to ".env" (same folder) and put YOUR values in.
# .env is git-ignored, so your real password is never committed.
# Do NOT wrap values in quotes. Real OS environment variables override this file.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecosched
DB_USERNAME=ecosched_user
DB_PASSWORD=your_mysql_password_here
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JPA_SHOW_SQL=false

# C scheduler binary. Leave empty to auto-detect scheduler/ecosched_scheduler.
SCHEDULER_BIN=
SCHEDULER_TIMEOUT_SECONDS=10
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
UPLOAD_DIR=uploads
